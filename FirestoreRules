rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
     // Kiểm tra xem người dùng đã đăng nhập chưa
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Kiểm tra xem người dùng có phải là chủ sở hữu của document không
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Kiểm tra xem người dùng có phải là thành viên của team không
    function isTeamMember(teamId) {
      return request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }

    // Rules cho collection users
    match /users/{userId} {
      // Cho phép đọc thông tin người dùng của bất kỳ ai đã đăng nhập
      allow read: if isAuthenticated();
      
      // Chỉ cho phép người dùng cập nhật thông tin của chính họ
      allow write: if isOwner(userId);
    }
    
    // Rules cho collection teams
    match /teams/{teamId} {
      // Chỉ cho phép thành viên team đọc thông tin team
      allow read: if isAuthenticated() && isTeamMember(teamId);
      
      // Cho phép người dùng đã đăng nhập tạo team mới
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      
      // Chỉ cho phép thành viên team cập nhật thông tin team
      allow update: if isAuthenticated() && isTeamMember(teamId);
      
      // Không cho phép xóa team
      allow delete: if false;
    }
  }
}